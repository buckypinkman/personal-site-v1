---
// src/layouts/Layout.astro
import '../styles/global.css';
import BackgroundSquares from '../components/BackgroundSquares.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  isFixedScreen?: boolean;
}

const {
  title = "Rangga Dimas | Software Engineer",
  description = "A Software Engineer from Indonesia passionate at building scalable systems, high-throughput microservices, and distributed architectures.",
  isFixedScreen = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://ranggadimas.dev');
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Rangga Dimas" />
    <meta name="keywords" content="Rangga Dimas, Software Engineer, Backend Engineer, Distributed Systems, Go, Golang, Kubernetes, Docker, Microservices, Astro" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/og-image.png" />

    <!-- Preconnect Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class={`bg-[#09090b] text-zinc-100 antialiased selection:bg-emerald-500/20 selection:text-white ${
    isFixedScreen ? 'h-screen md:overflow-hidden flex flex-col justify-between' : 'min-h-screen flex flex-col'
  }`}>
    <!-- Ambient Animated Looped Squares Canvas -->
    <BackgroundSquares />

    <!-- Top Navbar (no border) -->
    <Navbar />

    <!-- Main View Content -->
    <main class={`relative z-10 w-full flex-1 ${isFixedScreen ? 'flex items-center' : ''}`}>
      <slot />
    </main>

    <!-- Bordered Footer with Social Links -->
    <Footer isFixed={isFixedScreen} />
  </body>
</html>
