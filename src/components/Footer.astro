---
// src/components/Footer.astro
// Bordered footer with social media sites with simple logos fixed at the right
interface Props {
  isFixed?: boolean;
}

const { isFixed = false } = Astro.props;
---

<footer
  class={`w-full z-30 border-t border-zinc-800/80 bg-[#09090b]/90 backdrop-blur-md transition-all ${
    isFixed ? 'fixed bottom-0 left-0 right-0' : 'relative mt-auto'
  }`}
>
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-3.5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono">
    <!-- Left: Status / Location / Time -->
    <div class="flex items-center gap-3 text-zinc-400">
      <div class="flex items-center gap-2">
        <span class="text-zinc-300 font-medium">Jakarta, Indonesia</span>
      </div>
      <span class="text-zinc-700 hidden sm:inline">|</span>
      <span class="text-zinc-400 hidden sm:inline" id="live-time">GMT+7</span>
    </div>

    <!-- Right: Social Media Links with Simple Logos -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- GitHub -->
      <a
        href="https://github.com/buckypinkman"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-1.5 px-2.5 py-1 rounded text-zinc-400 hover:text-white hover:bg-zinc-800/60 border border-transparent hover:border-zinc-700/60 transition-all"
        aria-label="GitHub Profile"
      >
        <svg class="w-3.5 h-3.5 fill-current text-zinc-400 group-hover:text-white transition-colors" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/rangga-dimas-a41b721a6/"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-1.5 px-2.5 py-1 rounded text-zinc-400 hover:text-white hover:bg-zinc-800/60 border border-transparent hover:border-zinc-700/60 transition-all"
        aria-label="LinkedIn Profile"
      >
        <svg class="w-3.5 h-3.5 fill-current text-zinc-400 group-hover:text-blue-400 transition-colors" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.64 1.64 0 0 0-1.66 1.64 1.64 1.64 0 0 0 1.66 1.65 1.65 1.65 0 0 0 1.66-1.65A1.64 1.64 0 0 0 7.83 6.2z"></path>
        </svg>
        <span class="hidden sm:inline">LinkedIn</span>
      </a>

      <!-- Email -->
      <a
        href="mailto:rangga7765@gmail.com"
        class="group flex items-center gap-1.5 px-2.5 py-1 rounded text-zinc-400 hover:text-white hover:bg-zinc-800/60 border border-transparent hover:border-zinc-700/60 transition-all"
        aria-label="Send Email to rangga7765@gmail.com"
      >
        <svg class="w-3.5 h-3.5 stroke-current text-zinc-400 group-hover:text-emerald-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke-width="2">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span class="hidden sm:inline">Email</span>
      </a>
    </div>
  </div>
</footer>

<script>
  function updateJakartaTime() {
    const el = document.getElementById('live-time');
    if (!el) return;
    try {
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'Asia/Jakarta',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
      };
      const formatter = new Intl.DateTimeFormat([], options);
      el.textContent = `${formatter.format(new Date())} GMT+7`;
    } catch {
      el.textContent = 'GMT+7';
    }
  }

  updateJakartaTime();
  setInterval(updateJakartaTime, 1000);
</script>
