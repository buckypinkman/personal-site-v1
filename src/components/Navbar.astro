---
// src/components/Navbar.astro
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: 'Work', href: '/work' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
};
---

<header class="w-full z-40 relative px-6 md:px-12 py-5 transition-all">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Left: Brand Logo / Icon -->
    <a 
      href="/" 
      class="group flex items-center gap-2.5 text-zinc-100 hover:text-white transition-colors focus:outline-none"
      aria-label="Rangga Dimas Home"
    >
      <span class="w-4 h-4 rounded-[2px] border border-zinc-300 group-hover:border-white group-hover:bg-zinc-200/20 transition-all flex items-center justify-center">
        <span class="w-1.5 h-1.5 bg-zinc-100 rounded-[1px]"></span>
      </span>
      <span class="font-mono text-sm tracking-wider font-semibold uppercase text-zinc-200 group-hover:text-white">
        RANGGA
      </span>
    </a>

    <!-- Center/Right: Navigation Links (No border) -->
    <nav class="hidden md:flex items-center gap-6 sm:gap-8">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`text-xs sm:text-sm font-mono tracking-wide transition-colors ${
                active
                  ? 'text-white font-medium'
                  : 'text-zinc-400 hover:text-zinc-200'
              }`}
            >
              {link.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Right: Quick Action / GitHub Pill & Status Badge -->
    <div class="flex items-center gap-3">
      <a
        href="https://github.com/buckypinkman"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono text-zinc-300 bg-zinc-900/80 hover:bg-zinc-800 hover:text-white border border-zinc-800 hover:border-zinc-700 rounded-md transition-all shadow-sm"
      >
        <span>GitHub</span>
        <span class="text-zinc-500 font-mono">[buckypinkman]</span>
      </a>

      <a
        href="mailto:rangga7765@gmail.com"
        class="inline-flex items-center justify-center px-3.5 py-1 text-xs font-mono font-medium text-zinc-950 bg-zinc-100 hover:bg-white rounded-md transition-all shadow-sm active:scale-95"
      >
        Get in Touch
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-1.5 text-zinc-400 hover:text-white focus:outline-none rounded-md hover:bg-zinc-800/60"
        aria-label="Toggle navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden pt-4 pb-2 px-2 mt-2 bg-zinc-950/95 border border-zinc-800/80 rounded-lg backdrop-blur-xl shadow-2xl">
    <div class="flex flex-col gap-1 font-mono text-sm py-1">
      {
        navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 transition-colors ${
                active
                  ? 'text-white font-medium'
                  : 'text-zinc-400 hover:text-zinc-200'
              }`}
            >
              {link.name}
            </a>
          );
        })
      }
      <div class="pt-2 mt-2 border-t border-zinc-800/60 flex items-center justify-between text-xs text-zinc-400 px-3">
        <a href="https://github.com/buckypinkman" target="_blank" rel="noopener noreferrer" class="hover:text-white">
          GitHub: buckypinkman
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
