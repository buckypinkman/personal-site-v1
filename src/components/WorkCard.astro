---
// src/components/WorkCard.astro
// Replicating the exact card layout from Image 2 (OpenCode design system)
interface Props {
  index: string; // e.g. "01", "02", "03"
  title: string; // e.g. "deepseek-v4-flash" or "distributed-rate-limiter"
  organization: string; // e.g. "Core Infrastructure" or "High-Throughput Microservice"
  metric: string; // e.g. "40T" or "50k QPS" or "99.99%"
  delta: string; // e.g. "+195%" or "-25%" or "+4%"
  deltaType?: 'positive' | 'negative' | 'neutral';
  techStack: string[];
  description: string;
  githubUrl?: string;
  liveUrl?: string;
  watermarkType?: 'whale' | 'server' | 'cube' | 'cpu' | 'cloud';
}

const {
  index,
  title,
  organization,
  metric,
  delta,
  deltaType = 'positive',
  techStack,
  description,
  githubUrl,
  liveUrl,
  watermarkType = 'whale',
} = Astro.props;

const deltaColorClass =
  deltaType === 'positive'
    ? 'text-emerald-400'
    : deltaType === 'negative'
    ? 'text-rose-400'
    : 'text-zinc-400';
---

<div
  class="group relative bg-[#131316] hover:bg-[#18181d] border border-zinc-800/80 hover:border-zinc-700/90 rounded-none p-5 md:p-6 transition-all duration-300 overflow-hidden flex flex-col justify-between min-h-[220px] shadow-lg shadow-black/40"
>
  <!-- Background Watermark Silhouette (inspired by the large whale/brand mark in Image 2) -->
  <div class="absolute right-2 -bottom-4 sm:right-4 sm:-bottom-2 w-32 h-32 md:w-40 md:h-40 pointer-events-none opacity-[0.04] group-hover:opacity-[0.09] transition-opacity duration-300 flex items-center justify-center select-none text-zinc-100">
    {watermarkType === 'whale' && (
      <svg class="w-full h-full fill-current" viewBox="0 0 24 24">
        <path d="M19.5 9.5c-.8 0-1.5.7-1.5 1.5 0 .2 0 .4.1.6-1.3-.7-2.9-1.1-4.6-1.1-4.4 0-8 3.1-8 7 0 .4 0 .8.1 1.2-1.9-.3-3.6-1.4-4.6-3 1.3-.2 2.3-1.3 2.3-2.7 0-1.5-1.2-2.8-2.8-2.8-.2 0-.4 0-.6.1.4-1.7 1.4-3.2 2.8-4.2 1.3-1 2.9-1.6 4.7-1.6 3.1 0 5.9 1.7 7.3 4.2.3-.1.6-.2.9-.2 1.5 0 2.8 1.2 2.8 2.8 0 .4-.1.7-.2 1 .8.4 1.3 1.2 1.3 2.1 0 1.3-1 2.3-2.3 2.3z"/>
      </svg>
    )}
    {watermarkType === 'server' && (
      <svg class="w-full h-full stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.2">
        <rect width="20" height="8" x="2" y="2" rx="2" ry="2"/>
        <rect width="20" height="8" x="2" y="14" rx="2" ry="2"/>
        <line x1="6" x2="6.01" y1="6" y2="6"/>
        <line x1="6" x2="6.01" y1="18" y2="18"/>
      </svg>
    )}
    {watermarkType === 'cpu' && (
      <svg class="w-full h-full stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.2">
        <rect width="16" height="16" x="4" y="4" rx="2"/>
        <rect width="6" height="6" x="9" y="9" rx="1"/>
        <path d="M15 2v2m-6-2v2M15 20v2m-6-2v2M2 15h2m-2-6h2M20 15h2m-2-6h2"/>
      </svg>
    )}
    {watermarkType === 'cube' && (
      <svg class="w-full h-full stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.2">
        <path d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/>
      </svg>
    )}
  </div>


  <!-- Middle/Bottom Section: Title, Category/Org, Tech Stack, Links -->
  <div class="relative z-10 flex flex-col justify-between">
    <div>
      <!-- Main Title (e.g. deepseek-v4-flash) in bold monospace -->
      <h3 class="font-mono text-base md:text-lg font-bold text-white tracking-tight group-hover:text-emerald-300 transition-colors">
        {title}
      </h3>
      
      <!-- Organization / Subtitle -->
      <p class="font-mono text-xs text-zinc-400 mt-0.5">
        {organization}
      </p>
    </div>

    <!-- Description -->
    <p class="text-xs text-zinc-400 mt-2 line-clamp-2 leading-relaxed font-sans">
      {description}
    </p>

    <!-- Bottom Footer: Tech Stack Badges & Links -->
    <div class="mt-4 pt-3 border-t border-zinc-800/40 flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap gap-1.5">
        {techStack.map((tech) => (
          <span class="px-1.5 py-0.5 text-[10px] font-mono bg-zinc-800/60 text-zinc-300 border border-zinc-750 rounded-[2px]">
            {tech}
          </span>
        ))}
      </div>

      <div class="flex items-center gap-2 text-xs font-mono">
        {githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-zinc-400 hover:text-white hover:underline transition-colors"
          >
            Source ↗
          </a>
        )}
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-emerald-400 hover:text-emerald-300 font-medium hover:underline transition-colors"
          >
            Live Demo ↗
          </a>
        )}
      </div>
    </div>
  </div>
</div>
