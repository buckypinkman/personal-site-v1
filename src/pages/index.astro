---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import DotGridAccent from '../components/DotGridAccent.astro';
---

<Layout title="Rangga Dimas | Software Engineer" isFixedScreen={true}>
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12 py-4 md:py-0 flex flex-col justify-center my-auto">
    <!-- Hero Container matching OpenCode Data Design -->
    <div class="relative w-full max-w-6xl mx-auto">
      

      <!-- Main Headline Container with Dot Matrix Halftone Accent -->
      <div class="relative w-full">
        <!-- Dot Matrix Halftone Background Overlay behind the headline (from Image 1) -->
        <div class="absolute -inset-x-4 -inset-y-6 sm:-inset-x-8 sm:-inset-y-8 pointer-events-none opacity-60 z-0">
          <DotGridAccent width="w-full" height="h-44 sm:h-56 md:h-64" />
        </div>

        <!-- Huge Monospace / Neo-grotesque Title -->
        <h1 class="relative z-10 font-mono text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight text-white leading-none">
          Hi, I'm Rangga Dimas.
        </h1>
      </div>

      <!-- Subtitle Description - Right-Aligned / Offset (faithfully matching Image 1 layout) -->
      <div class="mt-8 sm:mt-12 md:mt-16 flex flex-col items-end w-full">
        <p class="font-mono text-sm sm:text-base md:text-lg text-zinc-300 max-w-xl text-right leading-relaxed tracking-tight">
          A Software Engineer that is passionate at building scalable systems.
        </p>
      </div>

    </div>
  </div>
</Layout>

<script>
  function updateHeroLiveDate() {
    const el = document.getElementById('hero-live-date');
    if (!el) return;
    try {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
        timeZone: 'Asia/Jakarta'
      };
      const formatted = new Intl.DateTimeFormat('en-US', options).format(now);
      el.textContent = `Updated ${formatted} GMT+7`;
    } catch {
      el.textContent = `Updated GMT+7`;
    }
  }

  updateHeroLiveDate();
</script>
